{
  "name": "woodcutter",
  "version": "3.0.0",
  "description": "A small, typed console logger built on winston",
  "keywords": [
    "log",
    "logger",
    "typescript",
    "winston"
  ],
  "author": "Olivier Schweitzer",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oschweitzer/woodcutter.git"
  },
  "bugs": "https://github.com/oschweitzer/woodcutter/issues",
  "homepage": "https://github.com/oschweitzer/woodcutter#readme",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/mark-formats.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "example": "node examples/basic.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.19.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
